{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"checkJs": true,
		"allowJs": true,
		"skipLibCheck": true,
		"types": [
			"vitest/globals"
		],
	},
	"include": [
		"**/*",
	],
	"exclude": [
		"tmp",
	],
}
