{
	"name": "@stylistic/stylelint-plugin",
	"description": "A collection of stylistic/formatting Stylelint rules",
	"version": "5.3.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/stylelint-stylistic/stylelint-stylistic#readme",
	"bugs": {
		"url": "https://github.com/stylelint-stylistic/stylelint-stylistic/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stylelint-stylistic/stylelint-stylistic.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"stylelint": "^17.15.0"
	},
	"dependencies": {
		"@csstools/css-parser-algorithms": "^4.0.0",
		"@csstools/css-tokenizer": "^4.0.1",
		"@csstools/media-query-list-parser": "^5.0.0",
		"postcss": "^8.5.28",
		"postcss-selector-parser": "^7.1.6",
		"postcss-value-parser": "^4.2.0",
		"style-search": "^0.1.0"
	},
	"scripts": {
		"help": "make help",
		"prepare": "./scripts/prepare.sh"
	},
	"devDependencies": {
		"@firefoxic/beautypography": "^0.1",
		"@firefoxic/oxlint-config": "^0.5",
		"@morev/stylelint-testing-library": "^1",
		"@types/node": "^26",
		"@vitest/coverage-v8": "4",
		"oxlint": "^1",
		"postcss-html": "^2",
		"postcss-less": "^6",
		"postcss-scss": "^4",
		"postcss-styled-syntax": "^0.7",
		"stylelint": "^17",
		"typescript": "^7",
		"vitest": "^4"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.10",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.6",
			"onFail": "download"
		}
	},
	"keywords": [
		"codeguide",
		"css",
		"csslint",
		"formatting",
		"lint",
		"linter",
		"stylelint",
		"stylelint-plugin",
		"stylistic"
	]
}
