{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": [
		"./node_modules/@firefoxic/oxlint-config/lib/syntactic.jsonc",
		"./node_modules/@firefoxic/oxlint-config/lib/stylistic.jsonc",
	],
	"env": {
		"node": true,
	},
	"globals": {
		"createTestRule": "readonly",
		"createTestRuleConfig": "readonly",
	},
	// Everything the shared config says holds. What stands below is what this plugin has a reason of its own for, and each entry carries that reason.
	"rules": {
		// A comment is not a line this rule is about: the plugin explains itself in prose, and counting that prose would punish the files that explain themselves best.
		"max-lines": [
			"error",
			{
				"skipComments": true,
				"skipBlankLines": true
			}
		],
		// The shape Stylelint asks a rule for counts twice over: `function rule (…)` holds the `(root, result) => { … }` it returns, so the same body is measured as two functions. The bar is set where it catches a walker that has genuinely grown rather than the shape itself.
		"max-lines-per-function": [
			"error",
			{
				"max": 100,
				"skipComments": true,
				"skipBlankLines": true
			}
		],
		// A JSDoc cast has to stand where the expression it types does, so a block opening on `@type` or `@param` is no comment inline with code but part of the code.
		"no-inline-comments": [
			"error",
			{
				"ignorePattern": "^\\*\\s*@(type|param)\\b"
			}
		],
		// Off for good: `eqeqeq` and `no-eq-null` are both on, so `value == null` is refused twice over, while this rule refuses `value === undefined`. Between the three there is no spelling left for the question the plugin asks 16 times, `typeof value === "undefined"` aside, and none of the 21 places handing `report` a `fix` of `undefined` reads better as a conditional spread.
		"no-undefined": "off",
		// Off for the whole project: a type is declared where it is named and exported there, and a rule opens on what it is — its name, its messages and its `meta` — and closes on the implementation. The shared config carries the rule still; it goes there with the next release.
		"import/exports-last": "off",
	},
	"overrides": [
		{
			// A TypeScript file carries its types in its signatures, and a JSDoc type beside them would be a second copy to fall out of step. The shared config will carry this once it is released with it; until then it stands here.
			"files": [
				"**/*.ts",
			],
			"rules": {
				"jsdoc/require-param-type": "off",
				"jsdoc/require-returns-type": "off",
			},
		},
		{
			// Three walkers written before the rule was on: the callback of `root.walk` and the one of `styleSearch` in `indentation`, and the callback of `parsedValue.walk` in the two `function-parentheses-*-inside` rules, where eight all but identical branches of `primary` stand one after another. The ceiling is what the worst of them counts today, so none of the three may grow, and it comes down as each is taken apart. The worst is `root.walk` in `indentation` since #280 took the ternaries out of `function-parentheses-space-inside`, whose walker set the ceiling before that.
			"files": [
				"lib/rules/function-parentheses-newline-inside/index.js",
				"lib/rules/function-parentheses-space-inside/index.js",
				"lib/rules/indentation/index.js",
			],
			"rules": {
				"complexity": [
					"error",
					27
				],
			},
		},
		{
			// The one rule that is long in code rather than in prose. The ceiling is what it counts today, so it may not grow, and it comes down if the file is ever taken apart the way its tests already are.
			"files": [
				"lib/rules/indentation/index.js",
			],
			"rules": {
				"max-lines": [
					"error",
					{
						"max": 427,
						"skipComments": true,
						"skipBlankLines": true
					}
				],
				"max-lines-per-function": [
					"error",
					{
						"max": 253,
						"skipComments": true,
						"skipBlankLines": true
					}
				],
			},
		},
		{
			// Five walkers that were long before the bar was set. The ceiling is what the longest of them counts today.
			"files": [
				"lib/rules/function-parentheses-space-inside/index.js",
				"lib/rules/no-eol-whitespace/index.js",
				"lib/rules/selector-attribute-brackets-space-inside/index.js",
				"lib/rules/string-quotes/index.js",
				"lib/utils/whitespaceChecker/index.ts",
			],
			"rules": {
				"max-lines-per-function": [
					"error",
					{
						"max": 173,
						"skipComments": true,
						"skipBlankLines": true
					}
				],
			},
		},
	],
}
